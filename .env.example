# 问己 AI Gateway — 按优先级选用第一个可用的 key
# 1. DeepSeek（推荐）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# 2. OpenAI 兼容接口
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 未配置任何 key 时自动走本地 mock（镜映优先 + 情绪释放 + 自见三字段）

# 仅 GitHub Pages 构建需要：云端接口地址（只是网址，不含密钥）
# NEXT_PUBLIC_API_URL=https://wenji-api-xxxx.sh.run.tcloudbase.com/api/ask
